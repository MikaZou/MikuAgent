# ===== DeepSeek API 配置（必填，否则运行在离线演示模式） =====
# 在 https://platform.deepseek.com 申请 API Key
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash = DeepSeek-V4.1-Flash，支持图片输入且比旧名 deepseek-chat 更快。
# 想回退：改成 deepseek-chat 即可（旧名仍可用，但不在账号模型列表里，有下线风险）。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.9
# 思考模式：disabled（默认，桌宠要快）/ enabled / auto（不下发该参数）
# 注意：flash 默认 enabled —— 会变慢，且**静默忽略 temperature**
DEEPSEEK_THINKING=disabled

# ===== 视觉（视频对话：让 Miku 看见主人）=====
# 默认关闭；实际开关在桌宠「设置」面板里，这里只提供初始值
VISION_ENABLED=false
# 摄像头索引（OpenCV device index）
VISION_CAMERA_INDEX=0
# 图片精细度：low(512x512，最省，实测约 192 tokens/张) / high / original / auto
VISION_DETAIL=low
# 发送前等比缩放的最长边（控制体积与 token）
VISION_MAX_SIDE=768
VISION_JPEG_QUALITY=80
# 本地预览帧率（只在本机显示，不上传）
VISION_PREVIEW_FPS=5

# ===== 记忆配置 =====
# 注入上下文的最近消息条数（短期记忆窗口）
MAX_HISTORY_MESSAGES=20

# ===== 运行配置 =====
# 强制离线演示模式（不调用 DeepSeek，用于无 Key 体验）
MOCK_MODE=false

# 桌宠窗口尺寸（像素）。
# 高度别随便改小：气泡（最多 132px）和输入栏之间要留出完整空间给模型，
# 360x600 是实测的平衡点：再降到 560 时只有 scale 0.70 能避开，模型会骤降一档。
# 改完尺寸要用 tools/measure_framing.py 重新量取景，并同步
# ui/pet_window.py 里的 FRAMING_SCALE / FRAMING_OFFSET。
WINDOW_WIDTH=360
WINDOW_HEIGHT=600
# 渲染帧率
WINDOW_FPS=60

# ===== 语音输出（TTS，让 Miku 说话） =====
# 总开关；也可在桌宠「设置」里随时切换
TTS_ENABLED=true
# 引擎（三选一）：
#   minimax = 云端 MiniMax，可用克隆的初音音色。
#             **最省资源**：不占显存、不吃 2.9GB 内存、无需预热，需联网与按量计费
#   sovits  = 本地 GPT-SoVITS，音色最准但要约 1.4~2.2GB 显存 + 2.9GB 内存
#   edge    = 微软在线 TTS，30KB 依赖，无克隆音色
#   none    = 关闭
TTS_ENGINE=minimax
# edge 音色。少女音候选：
#   zh-CN-XiaoyiNeural  晓伊（默认，年轻活泼）
#   zh-CN-XiaoxiaoNeural 晓晓
#   ja-JP-NanamiNeural  七海（纯日文）
TTS_VOICE=zh-CN-XiaoyiNeural
# 语速 / 音调 / 音量（仅 edge 引擎用）。音调调高更像动漫少女音。
TTS_RATE=+0%
TTS_PITCH=+25Hz
TTS_VOLUME=+0%
# 合成前的文本上限，超出截断
TTS_MAX_CHARS=200
# 合成缓存上限（MB），超出按最近最少使用淘汰。0 = 不限制
TTS_CACHE_MAX_MB=200

# ---- 仅 TTS_ENGINE=minimax 时使用（见 docs/TECHNICAL.md 5.5 节）----
# 在 https://platform.minimaxi.com 申请；复刻音色需先完成个人或企业实名认证
MINIMAX_API_KEY=
# 国内站 api.minimaxi.com；国际站 api.minimax.io
MINIMAX_BASE_URL=https://api.minimaxi.com
# speech-2.8-hd（音质最好）/ speech-2.8-turbo（最快）
MINIMAX_TTS_MODEL=speech-2.8-hd
# 克隆得到的音色 ID；留空则回退到系统音色 female-shaonv。
# 用 tools/minimax_clone_voice.py 生成（结果会自动写回 .env）。
# ⚠️ 克隆音色 168 小时内未被使用会被官方删除，需重新克隆。
MINIMAX_VOICE_ID=
# 语速。克隆自发布会致辞（本身偏慢）：1.0 只有 2.2 字/秒，1.8 约 3.7 字/秒（接近自然）。
# 可用 tools/minimax_speed_test.py 复测。
MINIMAX_SPEED=1.8
MINIMAX_TIMEOUT=120

# ===== 语音输入（STT）转写通道 =====
# local-whisper = 本地 faster-whisper，约 1GB 内存
# minimax       = 云端 ASR，几乎不吃内存（适合低配/手机场景）
STT_TRANSCRIBER=local-whisper

# ---- 仅 TTS_ENGINE=sovits 时使用 ----
# 推理设备：cuda / cpu
TTS_DEVICE=cuda
# 音色参考音频（5~10 秒干净人声，决定音色）。留空则 sovits 引擎不可用。
TTS_REF_AUDIO=
# 风格参考音频的转写文本（必填，必须与 TTS_REF_AUDIO 内容逐字一致）。
# 留空则 sovits 引擎不可用。
TTS_PROMPT_TEXT=
# 可选：风格参考音频（不填则复用 TTS_REF_AUDIO）
TTS_PROMPT_AUDIO=
# 可选：已训练的 GPT / SoVITS 权重路径（不填则用默认预训练模型）
TTS_GPT_MODEL=
TTS_SOVITS_MODEL=
# 是否启用 BERT（中文效果更好，多占约 0.65GB 显存；4GB 卡吃紧可设 false）
TTS_USE_BERT=true
# 启动时预热 CUDA graph：多花约 12 秒启动，换取之后全程稳态速度
# （不预热的话每种句长的头几次合成会慢 3~6 倍）
TTS_WARMUP=true
# 合成服务（独立进程）端口；被占用时换一个
TTS_SERVER_PORT=18520

# ===== 语音输入（STT，按住说话） =====
# Whisper 模型：tiny / base / small / medium（首次使用自动下载，越大越准越慢）
STT_MODEL=small
# 识别语言：zh / ja / en 等；留空 = 自动检测
STT_LANGUAGE=zh
# 短于此秒数的录音会被忽略（防误触）
STT_MIN_DURATION=0.3
# HuggingFace 下载镜像（国内网络默认 hf-mirror.com；留空 = 官方源）
STT_HF_ENDPOINT=https://hf-mirror.com
