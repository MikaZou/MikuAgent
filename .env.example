# ===== DeepSeek API 配置（必填，否则运行在离线演示模式） =====
# 在 https://platform.deepseek.com 申请 API Key
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.9

# ===== 记忆配置 =====
# 注入上下文的最近消息条数（短期记忆窗口）
MAX_HISTORY_MESSAGES=20

# ===== 运行配置 =====
# 强制离线演示模式（不调用 DeepSeek，用于无 Key 体验）
MOCK_MODE=false

# 桌宠窗口尺寸（像素）。模型底部贴着窗口底边，改尺寸后会自动适配。
WINDOW_WIDTH=460
WINDOW_HEIGHT=680
# 渲染帧率
WINDOW_FPS=60

# ===== 语音输出（TTS，让 Miku 说话） =====
# 总开关；也可在桌宠「设置」里随时切换
TTS_ENABLED=true
# 引擎：edge = 微软在线 TTS（默认，体积极小）
#       sovits = 本地 GPT-SoVITS，可克隆初音音色（需另装 requirements-tts.txt）
#       none = 关闭
TTS_ENGINE=edge
# edge 音色。少女音候选：
#   zh-CN-XiaoyiNeural  晓伊（默认，年轻活泼）
#   zh-CN-XiaoxiaoNeural 晓晓
#   ja-JP-NanamiNeural  七海（纯日文）
TTS_VOICE=zh-CN-XiaoyiNeural
# 语速 / 音调 / 音量。音调调高更像动漫少女音。
TTS_RATE=+0%
TTS_PITCH=+25Hz
TTS_VOLUME=+0%
# 合成前的文本上限，超出截断
TTS_MAX_CHARS=200
# 合成缓存上限（MB），超出按最近最少使用淘汰。0 = 不限制
TTS_CACHE_MAX_MB=200

# ---- 仅 TTS_ENGINE=sovits 时使用 ----
# 推理设备：cuda / cpu
TTS_DEVICE=cuda
# 音色参考音频（5~10 秒干净人声，决定音色）。留空则 sovits 引擎不可用。
TTS_REF_AUDIO=
# 风格参考音频的转写文本（必填，必须与 TTS_REF_AUDIO 内容逐字一致）。
# 留空则 sovits 引擎不可用。
TTS_PROMPT_TEXT=
# 可选：风格参考音频（不填则复用 TTS_REF_AUDIO）
TTS_PROMPT_AUDIO=
# 可选：已训练的 GPT / SoVITS 权重路径（不填则用默认预训练模型）
TTS_GPT_MODEL=
TTS_SOVITS_MODEL=
# 是否启用 BERT（中文效果更好，多占约 0.65GB 显存；4GB 卡吃紧可设 false）
TTS_USE_BERT=true
# 启动时预热 CUDA graph：多花约 12 秒启动，换取之后全程稳态速度
# （不预热的话每种句长的头几次合成会慢 3~6 倍）
TTS_WARMUP=true
# 合成服务（独立进程）端口；被占用时换一个
TTS_SERVER_PORT=18520

# ===== 语音输入（STT，按住说话） =====
# Whisper 模型：tiny / base / small / medium（首次使用自动下载，越大越准越慢）
STT_MODEL=small
# 识别语言：zh / ja / en 等；留空 = 自动检测
STT_LANGUAGE=zh
# 短于此秒数的录音会被忽略（防误触）
STT_MIN_DURATION=0.3
# HuggingFace 下载镜像（国内网络默认 hf-mirror.com；留空 = 官方源）
STT_HF_ENDPOINT=https://hf-mirror.com
